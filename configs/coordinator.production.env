# Coordinator production env. Source before running: waveos coordinator serve
# Example: set -a && source configs/coordinator.production.env && set +a && waveos coordinator serve
# Or: env $(grep -v '^#' configs/coordinator.production.env | xargs) waveos coordinator serve

# Require mTLS (client cert) for all coordinator API calls.
WAVEOS_COORDINATOR_REQUIRE_MTLS=1

# Set WAVEOS_COORDINATOR_AGENT_TOKEN via your secrets provider; do not commit.
# WAVEOS_COORDINATOR_AGENT_TOKEN=...

# Audit auth decisions to this path.
WAVEOS_COORDINATOR_AUDIT_PATH=out/coordinator_audit.jsonl

# TLS for coordinator server (set in env or here).
# WAVEOS_COORDINATOR_TLS=1
# WAVEOS_COORDINATOR_TLS_CERT=path/to/cert.pem
# WAVEOS_COORDINATOR_TLS_KEY=path/to/key.pem
